{
	"name": "messenger-clone",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "",
		"preview": "vite preview",
		"db:local": "turso dev -f local.db",
		"db:generate": "drizzle-kit generate --config=./src/lib/db/drizzle.config.ts",
		"db:push": "drizzle-kit push --config=./src/lib/db/drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=./src/lib/db/drizzle.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "~2.20.8",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/eslint": "^8.56.12",
		"autoprefixer": "^10.5.0",
		"eslint": "8.56.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^4.2.20",
		"svelte-check": "^3.8.6",
		"svelte-intersection-observer": "^1.1.1",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "7.17.0",
		"vite": "^5.4.21"
	},
	"type": "module",
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.14",
		"@internationalized/date": "^3.12.2",
		"@libsql/client": "^0.17.3",
		"better-auth": "^1.6.14",
		"bits-ui": "^0.21.16",
		"clsx": "^2.1.1",
		"cmdk-sv": "^0.0.18",
		"drizzle-orm": "^0.45.2",
		"formsnap": "^1.0.1",
		"ky": "^1.14.3",
		"lucide-svelte": "^0.412.0",
		"mode-watcher": "^0.3.1",
		"nanoid": "^5.1.11",
		"socket.io-client": "^4.8.3",
		"svelte-sonner": "^0.3.28",
		"sveltekit-superforms": "2.17.0",
		"tailwind-merge": "^2.6.1",
		"tailwind-variants": "^0.2.1",
		"zod": "^3.25.76"
	},
	"overrides": {
		"kysely": "^0.28.17"
	}
}
